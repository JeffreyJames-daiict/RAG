{
  "$schema": "./config.schema.json",
  "app": {
    "name": "Enterprise RAG Pipeline",
    "version": "0.1.0",
    "env": "development"
  },
  "database": {
    "url": "${DATABASE_URL:-postgresql://rag_user:rag_password_123@127.0.0.1:5432/rag}",
    "pool_size": 5,
    "max_overflow": 10,
    "echo": false
  },
  "storage": {
    "backend_type": "database",
    "raw_schema": "raw",
    "verify_on_read": true
  },
  "parser": {
    "version": "pymupdf-v1.0",
    "extract_images": false,
    "supported_mime_types": [
      "application/pdf",
      "application/x-pdf"
    ]
  },
  "chunking": {
    "chunk_size": 512,
    "chunk_overlap": 64,
    "chunking_version": "v1.0",
    "encoding_model": "cl100k_base"
  },
  "table": {
    "enabled": true,
    "max_rows_per_chunk": 15,
    "serialization_strategy": "hybrid",
    "summary_enabled": true,
    "parent_child_enabled": true,
    "wide_table_threshold": 8,
    "validation_enabled": true,
    "multipage_continuation_enabled": true,
    "continuation_confidence_threshold": 0.85,
    "cell_inheritance_enabled": true,
    "hierarchical_headers_enabled": true,
    "parent_expansion_neighbor_rows": 10,
    "max_expansion_rows": 50
  },
  "ocr": {
    "enabled": true,
    "provider": "tesseract",
    "language": "eng",
    "min_native_text_quality": 0.70,
    "min_confidence": 0.60,
    "max_retries": 2,
    "render_dpi": 300,
    "default_preprocessing": "standard",
    "mixed_content_merge": true,
    "iou_overlap_threshold": 0.30
  },
  "normalization": {
    "enabled": true,
    "min_text_length": 10,
    "min_word_count": 3,
    "ocr_confidence_threshold": 0.60,
    "duplicate_similarity_threshold": 0.85,
    "header_repeat_threshold": 3,
    "footer_repeat_threshold": 3,
    "max_symbol_ratio": 0.30,
    "excessive_repetition_threshold": 0.70,
    "unicode_normalization_form": "NFC",
    "repair_soft_hyphens": true,
    "remove_headers": true,
    "remove_footers": true,
    "remove_standalone_page_numbers": true
  },
  "asset": {
    "enabled": true,
    "storage_backend_type": "minio",
    "min_image_width": 64,
    "min_image_height": 64,
    "min_image_area": 4096,
    "max_aspect_ratio": 8.0,
    "filter_decorative": true,
    "caption_detection_enabled": true,
    "caption_vertical_distance_pts": 60.0,
    "figure_ocr_enabled": true,
    "figure_ocr_min_confidence": 0.40,
    "relevance_enabled": true,
    "analyze_threshold": 0.65,
    "store_only_threshold": 0.35,
    "ocr_only_threshold": 0.50,
    "max_vision_calls_per_document": 20,
    "dedup_enabled": true,
    "perceptual_hash_enabled": true,
    "phash_hamming_distance_threshold": 5,
    "weights": {
      "caption": 0.20,
      "figure_label": 0.10,
      "technical_ocr": 0.20,
      "meaningful_ocr_length": 0.10,
      "technical_context": 0.10,
      "informative_aspect_size": 0.05,
      "large_page_coverage": 0.05,
      "repeated_asset_penalty": -0.25,
      "logo_penalty": -0.40,
      "watermark_penalty": -0.50,
      "tiny_icon_penalty": -0.50,
      "empty_ocr_penalty": -0.05
    },
    "vision": {
      "enabled": true,
      "provider": "openrouter/free",
      "model": "openrouter/free",
      "api_key": "${OPENROUTER_API_KEY:-}",
      "endpoint_url": "https://openrouter.ai/api/v1/chat/completions",
      "timeout_sec": 45.0,
      "max_retries": 2,
      "retry_backoff_sec": 1.0,
      "max_image_dimension": 2048,
      "extract_relationships": true
    }
  },
  "embedding": {
    "enabled": true,
    "provider": "mock",
    "model": "text-embedding-3-small",
    "model_version": "v1.0",
    "dimension": 1536,
    "batch_size": 64,
    "max_retries": 3,
    "retry_backoff_sec": 1.0,
    "timeout_sec": 30.0,
    "max_input_tokens": 8191,
    "oversized_chunk_strategy": "truncate",
    "api_key": "${OPENAI_API_KEY:-}",
    "endpoint_url": null
  },
  "retrieval": {
    "enabled": true,
    "backend": "auto",
    "default_top_k": 5,
    "max_top_k": 100,
    "similarity_threshold": null,
    "candidate_limit": 1000,
    "distance_metric": "cosine",
    "allow_inactive_documents": false,
    "allow_python_fallback": true,
    "strict_embedding_validation": true,
    "query_timeout_sec": 10.0,
    "max_metadata_filter_size": 25,
    "hybrid_enabled": true,
    "rrf_k": 60,
    "bm25_k1": 1.5,
    "bm25_b": 0.75
  },
  "pipeline": {
    "default_tenant_id": "default",
    "handle_deletions": true,
    "force_fetch": false,
    "auto_migrate": true
  },
  "query_rewrite": {
    "enabled": false,
    "provider": "mock",
    "model": "google/gemini-2.5-flash",
    "max_queries": 5,
    "timeout_sec": 5.0,
    "confidence_threshold": 0.3,
    "fallback_enabled": true,
    "temperature": 0.3,
    "max_tokens": 500,
    "enable_expansion": true,
    "enable_multi_query": true,
    "enable_hyde": false,
    "enable_decomposition": true,
    "enable_conversation": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
