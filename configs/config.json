{
  "$schema": "./config.schema.json",
  "app": {
    "name": "Enterprise RAG Pipeline",
    "version": "0.1.0",
    "env": "development"
  },
  "database": {
    "url": "${DATABASE_URL:-postgresql://rag_user:rag_password_123@127.0.0.1:5432/rag}",
    "pool_size": 5,
    "max_overflow": 10,
    "echo": false
  },
  "storage": {
    "backend_type": "database",
    "raw_schema": "raw",
    "verify_on_read": true
  },
  "parser": {
    "version": "pymupdf-v1.0",
    "extract_images": false,
    "supported_mime_types": [
      "application/pdf",
      "application/x-pdf"
    ]
  },
  "chunking": {
    "chunk_size": 512,
    "chunk_overlap": 64,
    "chunking_version": "v1.0",
    "encoding_model": "cl100k_base"
  },
  "table": {
    "enabled": true,
    "max_rows_per_chunk": 15,
    "serialization_strategy": "hybrid",
    "summary_enabled": true,
    "parent_child_enabled": true,
    "wide_table_threshold": 8,
    "validation_enabled": true,
    "multipage_continuation_enabled": true,
    "continuation_confidence_threshold": 0.85,
    "cell_inheritance_enabled": true,
    "hierarchical_headers_enabled": true,
    "parent_expansion_neighbor_rows": 10,
    "max_expansion_rows": 50
  },
  "ocr": {
    "enabled": true,
    "provider": "tesseract",
    "language": "eng",
    "min_native_text_quality": 0.70,
    "min_confidence": 0.60,
    "max_retries": 2,
    "render_dpi": 300,
    "default_preprocessing": "standard",
    "mixed_content_merge": true,
    "iou_overlap_threshold": 0.30
  },
  "normalization": {
    "enabled": true,
    "min_text_length": 10,
    "min_word_count": 3,
    "ocr_confidence_threshold": 0.60,
    "duplicate_similarity_threshold": 0.85,
    "header_repeat_threshold": 3,
    "footer_repeat_threshold": 3,
    "max_symbol_ratio": 0.30,
    "excessive_repetition_threshold": 0.70,
    "unicode_normalization_form": "NFC",
    "repair_soft_hyphens": true,
    "remove_headers": true,
    "remove_footers": true,
    "remove_standalone_page_numbers": true
  },
  "pipeline": {
    "default_tenant_id": "default",
    "handle_deletions": true,
    "force_fetch": false,
    "auto_migrate": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}
