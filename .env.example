DB_NAME=rag
DB_HOST=127.0.0.1
DB_USER=rag_user
DB_PASSWORD=your_password_here
DB_PORT=5432
DATABASE_URL=postgresql://rag_user:your_password_here@127.0.0.1:5432/rag

# MinIO / S3 Configuration
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=rag

# OpenRouter Free Vision API (Free tier: Gemini, LLaMA 3.2 Vision, Qwen 2.5 VL)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Directory for immutable raw document copies (when storage.backend_type=local)
RAW_STORAGE_DIR=./raw_store

